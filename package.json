{
  "name": "subprocessors",
  "version": "0.1.0",
  "description": "Your sub-processor list, drafted from your code: reads package.json, imports, env variable names (never values) and vercel.json, wrangler.toml and Terraform, and drafts the GDPR Art. 28 list with each vendor's purpose, a data-category guess, the region where the code says it, the vendor's DPA and its own list, and the file and line each row was detected from. A CLI, a GitHub Action that flags a pull request adding a vendor, and a local MCP tool. Local only: no account, no requests. A draft to review, not legal advice.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "subprocessors": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples/demo-repo",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentwares/subprocessors.git"
  },
  "homepage": "https://agentwares-agentcheck.vercel.app/subprocessors",
  "bugs": {
    "url": "https://github.com/agentwares/subprocessors/issues"
  },
  "keywords": [
    "subprocessors",
    "sub-processors",
    "gdpr",
    "article-28",
    "dpa",
    "data-processing-agreement",
    "privacy",
    "compliance",
    "vendors",
    "trust-center",
    "soc2",
    "github-action",
    "mcp",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "pretest": "pnpm run build:dist",
    "pretypecheck": "pnpm run build:dist",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build:dist": "tsup"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
